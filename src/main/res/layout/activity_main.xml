<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cifras Gospel"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Suas músicas gospel cifradas em um só lugar."
            android:textSize="16sp" />

        <EditText
            android:id="@+id/busca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Buscar música ou artista" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Músicas"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listaMusicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Amazing Grace — Tradicional&#10;&#10;Santo, Santo, Santo — Tradicional&#10;&#10;Mais músicas em breve"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
